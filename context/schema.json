{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Core v1",
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "value",
        "status",
        "valid_from",
        "valid_to",
        "source",
        "last_verified_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "current",
            "historical",
            "candidate",
            "invalidated"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "last_verified_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "authority",
        "reference",
        "last_verified_at",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "user_explicit",
            "project_sot",
            "derived",
            "inferred"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "last_verified_at": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "facts"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "current",
            "profile",
            "timeline",
            "projects"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "sources"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    }
  ]
}
