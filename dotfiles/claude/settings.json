{
  "env": {
    "MCP_TIMEOUT": "30000"
  },
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "enableWorkflows": true,
  "skipWorkflowUsageWarning": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "language": "korea",
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude/memory",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\user\\.claude\\statusline.ps1\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "codex@openai-codex": true,
    "lazyweb@lazyweb": true,
    "workflow@yohan-cc-skills": true,
    "statusline@yohan-cc-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "yohan-core@yohan-cc-skills": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      }
    },
    "lazyweb": {
      "source": {
        "source": "git",
        "url": "https://github.com/aboul3ata/lazyweb-skill.git"
      }
    },
    "yohan-cc-skills": {
      "source": {
        "source": "github",
        "repo": "byh3071-cpu/yohan-cc-skills"
      }
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
