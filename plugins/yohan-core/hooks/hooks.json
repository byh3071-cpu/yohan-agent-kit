{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|Write|Edit|Read",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-secrets.ps1\"",
                                                           "commandWindows":  "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"\u0026 (Join-Path $env:CLAUDE_PLUGIN_ROOT \u0027hooks/protect-secrets.ps1\u0027)\"",
                                                           "timeout":  15
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/destructive-guard.ps1\"",
                                                           "commandWindows":  "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"\u0026 (Join-Path $env:CLAUDE_PLUGIN_ROOT \u0027hooks/destructive-guard.ps1\u0027)\"",
                                                           "timeout":  15
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "if":  "Bash(git commit *)",
                                                           "command":  "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-check.ps1\"",
                                                           "commandWindows":  "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"\u0026 (Join-Path $env:CLAUDE_PLUGIN_ROOT \u0027hooks/pre-commit-check.ps1\u0027)\"",
                                                           "timeout":  60
                                                       }
                                                   ]
                                     }
                                 ]
              }
}
